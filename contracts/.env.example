# Semua wallet butuh BNB testnet. Isi dari faucet: https://testnet.bnbchain.org/faucet-smart

RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# Deployer sekaligus admin (grant AI_AGENT_ROLE). Butuh BNB testnet untuk gas.
DEPLOYER_PRIVATE_KEY=

# Wallet backend milik AI Agent (sama dengan AGENT_PRIVATE_KEY di backend/.env).
AGENT_PRIVATE_KEY=

# Wallet payment/recipient untuk E2E. Butuh BNB testnet untuk gas.
PAYER_PRIVATE_KEY=
RECIPIENT_PRIVATE_KEY=

# Diisi OTOMATIS dari output script deploy:
CONTRACT_ADDRESS=
TOKEN_ADDRESS=
