# ===== MileAI Backend - contoh env (salin ke `backend/.env`) =====
# JANGAN commit `backend/.env` (sudah di .gitignore).

# RPC BSC Testnet (public & gratis). Ganti bila seed ini down.
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545

# Alamat kontrak MilestoneEscrow hasil `forge script script/Deploy.s.sol`.
CONTRACT_ADDRESS=

# Satu-satunya private key yang dipegang backend = wallet AI Agent
# (khusus untuk autoRelease). Sama dengan AGENT_PRIVATE_KEY di contracts/.env.
AGENT_PRIVATE_KEY=

# ABI kontrak (default sudah menuju artifact build forge di contracts/out/...).
# CONTRACT_ABI_PATH=../contracts/out/MilestoneEscrow.sol/MilestoneEscrow.json

# LLM free tier. provider: "groq" atau "gemini".
LLM_API_KEY=
LLM_PROVIDER=groq
# LLM_MODEL=   # kosong = default (groq: llama-3.3-70b-versatile, gemini: gemini-2.0-flash)

# Behavior agent (opsional, nilai default seperti di bawah).
# POLL_INTERVAL_SECONDS=12
# CONFIDENCE_AUTO=85
# CONFIDENCE_REVIEW_MIN=50
# PROOF_MIN_LEN_FOR_HIGH_SCORE=120
# HIGH_SCORE_LIMIT=98