# MileAI frontend — example environment. Copy to `.env.local` then adjust.
# (all variables are public, safe to use in the browser/Vercel)

# --- REQUIRED before use ---
# MilestoneEscrow contract address FROM YOUR DEPLOY.
# - Real testnet: replace after deploying (faucet done).
# - Local anvil dev: fill in the address from Deploy.s.sol, e.g. 0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
#   AND set NEXT_PUBLIC_CHAIN_ID=31337.
NEXT_PUBLIC_CONTRACT_ADDRESS=

# FastAPI backend address (AI agent / AI status viewer).
# See backend/.env, section ALLOWED_CORS_ORIGINS — make sure the frontend origin is listed there.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Target chain: 97 = BSC Testnet. 31337 = local anvil for development.
NEXT_PUBLIC_CHAIN_ID=97

# Optional: public RPC fallback (only used when adding the network to MetaMask).
NEXT_PUBLIC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545

# Anti-spam token for POST /agent/trigger. Must be the SAME as
# AGENT_TRIGGER_TOKEN in backend/.env. Empty = backend doesn't require a token
# (default local dev mode). Fill it in to prevent spam from third parties.
# NEXT_PUBLIC_TRIGGER_TOKEN=