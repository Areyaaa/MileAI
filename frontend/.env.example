# Frontend MileAI — contoh environment. Copy ke `.env.local` lalu sesuaikan.
# (semua variabel publik, aman dipakai di browser/Vercel)

# --- WAJIB diisi sebelum dipakai---
# Alamat kontrak MilestoneEscrow HASIL DEPLOY.
# - Testnet beneran: ganti setelah deploy (faucet) selesai.
# - Dev lokal anvil: isi alamat dari Deploy.s.sol mis. 0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
#   DAN set NEXT_PUBLIC_CHAIN_ID=31337.
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Alamat backend FastAPI (AI agent / status viewer AI).
# Lihat di backend/.env, bagian ALLOWED_CORS_ORIGINS — pastikan origin frontend ada di sana.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Chain target: 97 = BSC Testnet. 31337 = anvil lokal untuk development.
NEXT_PUBLIC_CHAIN_ID=97

# Opsional: fallback public RPC (cuma dipakai saat menambah network ke MetaMask).
NEXT_PUBLIC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545

# Token anti-spam untuk POST /agent/trigger. Harus SAMA dengan
# AGENT_TRIGGER_TOKEN di backend/.env. Kosong = backend tidak meminta token
# (default mode dev lokal). Diisi untuk mencegah spam dari pihak ketiga.
# NEXT_PUBLIC_TRIGGER_TOKEN=